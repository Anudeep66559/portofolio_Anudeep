{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "moduleResolution": "bundler",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noEmitOnError": false,
    "noCheck": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./public",
    "rootDir": "./src",
    "sourceMap": false,
    "declaration": false,
    "removeComments": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
